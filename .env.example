GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_INSTALLATION_ID=optional-installation-id-for-live-tests

GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key
PRIMARY_MODEL_ID=your-primary-google-ai-studio-model-id
FALLBACK_MODEL_ID=your-fallback-google-ai-studio-model-id
